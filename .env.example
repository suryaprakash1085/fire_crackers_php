# ===== Application =====
APP_NAME="Sri Murugan Crackers"
APP_ENV=local                 # local | production   (production blocks migrate:fresh)
APP_DEBUG=true                # false on a live server
APP_URL=http://127.0.0.1:8000
# Secret used to encrypt the saved SMTP password. `php bin/console install` / `key:generate` fills this in.
APP_KEY=change-me-to-a-long-random-string
APP_TIMEZONE=Asia/Kolkata

# ===== Database (MySQL 8 / MariaDB) =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=firecracker_shop_v3
DB_USER=firecracker_shop_v3
DB_PASS=firecracker_shop_v3

# ===== AI image generation (OpenAI Images API) — leave empty to disable =====
OPENAI_API_KEY=
AI_IMAGE_MODEL=gpt-image-1    # or dall-e-3

# ===== SMTP fallback (Admin > Email Settings overrides these) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls           # tls | ssl | none
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=

# ===== Front-end =====
TAILWIND_CDN=false            # false = use the compiled public/assets/css/tailwind.css (run `npm run build:css` after adding new classes). true = Tailwind CDN.
FORCE_HTTPS=false             # true = redirect http:// to https:// (the microphone for Voice Order only works on HTTPS)
