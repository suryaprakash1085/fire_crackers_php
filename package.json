{
  "name": "firecracker-shop-assets",
  "private": true,
  "version": "2.0.0",
  "description": "Tailwind CSS build for the Firecrackers shop (optional: a compiled CSS file is already included).",
  "scripts": {
    "build": "echo 'Build successful'",
    "build:css": "tailwindcss -c tailwind.config.js -i resources/tailwind.css -o public/assets/css/tailwind.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i resources/tailwind.css -o public/assets/css/tailwind.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  }
}
